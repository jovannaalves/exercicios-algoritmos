Algoritmo "mesesVividos"
// Disciplina   : [Linguagem e Lógica de Programação]
// Professor   : Gabriel Sena
// Descrição   : Leia a idade de uma pessoa e mostre quantos meses
//completos ela já viveu, considerando 12 meses por ano.
// Autor(a)    : Jovanna Alves
// Data atual  : 28/10/2026
Var
   idade, mesesVividos: inteiro


Inicio
   escreval("Digite sua Idade: ")
   leia(idade)

   mesesVividos <- idade*12

   escreval("Você já viveu: ", mesesVividos, "meses completos.")


Fimalgoritmo